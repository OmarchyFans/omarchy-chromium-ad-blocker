{
  "manifest_version": 3,
  "name": "Omarchy Chromium Ad Blocker",
  "version": "3.0",
  "key": "",
  "description": "Removes ads, declines tracking consent, blocks third-party trackers and clears passive legal notices. Each is its own opt-in; a model on your own GPU handles what the rules miss.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "cookies",
    "privacy",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "consent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Omarchy Chromium Ad Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "trackers",
        "enabled": false,
        "path": "rules/trackers.json"
      }
    ]
  },
  "incognito": "spanning"
}
