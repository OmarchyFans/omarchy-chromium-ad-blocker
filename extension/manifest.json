{
  "manifest_version": 3,
  "name": "Omarchy Chromium Ad Blocker",
  "version": "2.0",
  "key": "",
  "description": "Removes ads, cookie walls and popup overlays. Static rules and DOM heuristics run instantly; a model on your own GPU classifies what is left, and every verdict is cached per site.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Omarchy Ad Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
