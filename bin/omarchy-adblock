#!/bin/bash

# omarchy:summary=Manage the Chromium ad blocker: status, backend, learned rules

set -euo pipefail

# Only system directories: nothing this script runs (python3, curl, pgrep,
# chromium) can be shadowed by an executable dropped earlier on someone's PATH.
export PATH="/usr/local/bin:/usr/bin:/bin"

CONFIG_DIR="$HOME/.config/omarchy-adblock"
CONFIG="$CONFIG_DIR/config.json"
DATA_DIR="$HOME/.local/share/omarchy-adblock"
RULES="$DATA_DIR/rules"
USER_RULES="$DATA_DIR/user"
# The update helper next to this script (docs/update-alerts.md), never one on PATH.
UPDATE_SH="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)/lib/update.sh"

usage() {
  cat <<USAGE
Usage: omarchy-adblock <command>

  status              What is installed, configured and learned
  off                 Stop loading the extension in Chromium at all
  on                  Load it again (both ask before closing Chromium; --yes skips)
  dashboard           Status, statistics and incognito access, then wait (the bar button opens this)
  mode [manual|auto]  Manual: nothing goes until you press the chord (default).
                      Auto: ads are removed as each page loads.
  backend [local|anthropic]
                      Local runs on your GPU and sends nothing off the machine.
  endpoint <url>      Where the local model listens (default http://127.0.0.1:8080)
  stats [host]        What has been removed: ads, trackers, consent, legal
  private [on|off]    Always open Chromium in incognito, and keep history here
  incognito [on|off]  Let the blocker run in incognito windows, in every profile
                      (closes and reopens Chromium to change it)
  history [search]    Your locally kept history (only recorded in private mode)
  sites               Sites with learned rules, and how many each has
  show <host>         The rules learned for one site
  marked [host]       The ads you marked by hand
  forget <host>       Throw away one site's learned rules (keeps your own)
  forget-all          Throw away every learned rule (keeps your own)
  unmark <host>       Throw away what you marked by hand on one site
  key <api-key>       Store the Anthropic API key (only for that backend)
  model <id>          Set the Anthropic model
  log [n]             Last n lines of the host error log
  restart             Fully restart Chromium so changes take effect
  update-check [VERSION] [--force]
                      Is a newer version of the plugin published? (JSON, cached 6 h)
  update-dismiss <version> | update-run [all|install]
                      Stop offering that version; open a terminal that updates the plugin
USAGE
}

EXT_ID="fohhgkaemdiabgidgoajbgnccfccchac"
CHROMIUM_DIR="$HOME/.config/chromium"

# Chromium keeps "Allow in Incognito" per profile in its Preferences file and
# rewrites that file on exit, so it can only be changed with Chromium closed.
# An extension cannot grant itself this; the person running this command can.
incognito_prefs() {
  python3 - "$CHROMIUM_DIR" "$EXT_ID" "$1" <<'PY2'
import json, os, pathlib, sys
root, ext, action = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
names = {}
try:
    cache = json.loads((root / "Local State").read_text())["profile"]["info_cache"]
    names = {k: v.get("name", k) for k, v in cache.items()}
except Exception:
    pass
found = 0
for prefs in sorted(root.glob("*/Preferences")):
    folder = prefs.parent.name
    if folder in ("System Profile", "Guest Profile"):
        continue
    try:
        data = json.loads(prefs.read_text())
    except Exception:
        continue
    entry = data.get("extensions", {}).get("settings", {}).get(ext)
    label = f"{names.get(folder, folder)} ({folder})"
    if entry is None:
        print(f"  {label:36} not loaded in this profile yet")
        continue
    found += 1
    if action == "status":
        print(f"  {label:36} {'on' if entry.get('incognito') else 'off'}")
        continue
    entry["incognito"] = action == "on"
    tmp = prefs.with_suffix(".omarchy-tmp")
    tmp.write_text(json.dumps(data, separators=(",", ":")))
    os.chmod(tmp, prefs.stat().st_mode & 0o777)
    tmp.replace(prefs)
    print(f"  {label:36} {action}")
if not found:
    print("  No profile has loaded the extension yet. Start Chromium once, then run this again.")
PY2
}

chromium_running() { pgrep -x chromium >/dev/null 2>&1; }

# Closing Chromium loses whatever is open, so it is never done silently: with no
# terminal to ask on (a script, a hook, an agent), the answer is no and the
# change waits for the next start instead.
WAS_RUNNING=0
close_chromium() {
  local why="$1" reply
  WAS_RUNNING=0
  chromium_running || return 0
  WAS_RUNNING=1
  if (( YES )); then
    :
  elif [[ -t 0 ]]; then
    read -r -p "$why Close Chromium and reopen it now? [y/N] " reply
    [[ $reply =~ ^[Yy] ]] || return 1
  else
    return 1
  fi
  pkill -x chromium 2>/dev/null || true
  for _ in $(seq 1 50); do chromium_running || break; sleep 0.2; done
  chromium_running && { echo "Chromium did not close." >&2; return 1; }
  return 0
}

reopen_chromium() {
  (( WAS_RUNNING )) || return 0
  setsid -f chromium >/dev/null 2>&1 || true
  echo "Chromium restarted."
}

REPO_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
EXT_DIR="$REPO_DIR/browser/extension"
FLAG_FILES=(chromium-flags.conf chrome-flags.conf brave-flags.conf)

# Is the extension on Chromium's --load-extension line?
ext_loaded() {
  grep -qsF -- "$EXT_DIR" "$HOME/.config/chromium-flags.conf"
}

# Add or remove the extension from every flags file that exists. This is the
# off switch that works when the popup cannot be reached: the extension is not
# loaded at all, so nothing of it runs anywhere, in any profile.
ext_flags() {
  local want="$1" file changed=0
  for flags in "${FLAG_FILES[@]}"; do
    file="$HOME/.config/$flags"
    [[ -f $file ]] || continue
    python3 - "$file" "$EXT_DIR" "$want" <<'PY3' && changed=1
import pathlib, sys
path, ext, want = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
lines = path.read_text().splitlines()
out, seen = [], False
for line in lines:
    if line.startswith("--load-extension="):
        seen = True
        paths = [p for p in line.split("=", 1)[1].split(",") if p]
        if want == "on" and ext not in paths:
            paths.append(ext)
        elif want == "off":
            paths = [p for p in paths if p != ext]
        # An empty --load-extension= is read as a path Chromium cannot find.
        if not paths:
            continue
        line = "--load-extension=" + ",".join(paths)
    out.append(line)
if want == "on" and not seen:
    out.append("--load-extension=" + ext)
path.write_text("\n".join(out) + "\n")
PY3
  done
  (( changed ))
}

set_extension() {
  local want="$1"
  if [[ $want == on ]] && ext_loaded; then
    echo "Already on."
  elif [[ $want == off ]] && ! ext_loaded; then
    echo "Already off."
  else
    ext_flags "$want" || { echo "No Chromium flags file to edit." >&2; exit 1; }
    echo "Ad blocker $want: the extension is $([[ $want == on ]] && echo "loaded" || echo "not loaded") from the next Chromium start."
  fi
  if close_chromium "Chromium reads its extensions only at startup."; then
    reopen_chromium
  else
    echo "Left Chromium alone; it takes effect the next time you start it (omarchy-adblock restart)."
  fi
}

set_incognito() {
  local want="$1"
  # Chromium rewrites these settings when it exits, so they can only be changed
  # with it closed.
  if ! close_chromium "Chromium overwrites this setting when it exits."; then
    echo "Nothing changed — close Chromium and run this again." >&2
    exit 1
  fi
  echo "Allow in Incognito:"
  incognito_prefs "$want"
  reopen_chromium
}

# One helper for every scalar read, so a hand-edited config with a missing key
# still prints a status instead of a traceback.
cfg_get() {
  python3 -c '
import json, pathlib, sys
default = sys.argv[3]
try:
    print(json.loads(pathlib.Path(sys.argv[2]).read_text()).get(sys.argv[1], default))
except Exception:
    print(default)
' "$1" "$CONFIG" "${2:-}"
}

cfg_set() {
  mkdir -p "$CONFIG_DIR"
  python3 - "$CONFIG" "$1" "$2" "${3:-str}" <<'PY'
import json, pathlib, sys
path, key, raw, kind = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
cfg = {}
if path.is_file():
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        cfg = {}
cfg[key] = {"true": True, "false": False}[raw] if kind == "bool" else raw
path.write_text(json.dumps(cfg, indent=2) + "\n")
PY
}

count_json() { ls -1 "$1"/*.json 2>/dev/null | wc -l; }

rule_count() {
  python3 -c '
import json, sys
try:
    print(len(json.load(open(sys.argv[1]))["block"]))
except Exception:
    print("?")
' "$1"
}

YES=0
for a in "$@"; do [[ $a == --yes || $a == -y ]] && YES=1; done
set -- "${@/--yes/}"; set -- "${@/-y/}"

case "${1:-status}" in
off | on)
  set_extension "$1"
  ;;

status)
  backend=$(cfg_get backend local)
  echo "omarchy-chromium-ad-blocker"
  echo
  if ext_loaded; then
    echo "  Extension   loaded via ~/.config/chromium-flags.conf (turn off with: omarchy-adblock off)"
  elif [[ -f "$HOME/.config/chromium-flags.conf" ]]; then
    echo "  Extension   OFF — not loaded by Chromium (turn on with: omarchy-adblock on)"
  else
    echo "  Extension   NOT in chromium-flags.conf — run ./install.sh"
  fi
  echo "  Blocking    off until you flip the switch at the top of the extension popup, per Chromium profile"
  if [[ -f "$HOME/.config/chromium/NativeMessagingHosts/com.omarchy.adblock.json" ]]; then
    echo "  Host        registered"
  else
    echo "  Host        NOT registered — run ./install.sh"
  fi
  echo "  Mode        $(cfg_get mode manual)"
  echo "  Backend     $backend"
  if [[ $backend == "local" ]]; then
    endpoint=$(cfg_get local_endpoint http://127.0.0.1:8080)
    if curl -sf --max-time 3 "$endpoint/v1/models" >/dev/null 2>&1; then
      # The served path is the whole answer to "which model", so print its name.
      name=$(curl -sf --max-time 3 "$endpoint/v1/models" |
        python3 -c 'import json,sys,os; print(os.path.basename(json.load(sys.stdin)["data"][0]["id"]))' 2>/dev/null || echo "?")
      echo "  Local model $name at $endpoint"
    else
      echo "  Local model nothing answering at $endpoint — heuristics only"
    fi
  else
    if [[ -f "$CONFIG_DIR/env" ]] && grep -qE '^ANTHROPIC_API_KEY=.+' "$CONFIG_DIR/env"; then
      echo "  API key     set · $(cfg_get model claude-haiku-4-5)"
    else
      echo "  API key     not set — heuristics only"
    fi
    if [[ -x "$DATA_DIR/venv/bin/python" ]]; then
      echo "  SDK         $("$DATA_DIR/venv/bin/python" -c 'import anthropic;print("anthropic "+anthropic.__version__)' 2>/dev/null || echo 'missing — ./install.sh --with-anthropic')"
    else
      echo "  SDK         not installed — ./install.sh --with-anthropic"
    fi
  fi
  echo "  Learned     $(count_json "$RULES") sites"
  echo "  Marked      $(count_json "$USER_RULES") sites with hand-marked ads"
  # Chromium throws away the host's stderr, so this log is the only place a
  # broken model pass ever shows up.
  if [[ -s "$DATA_DIR/host.log" ]]; then
    echo "  Last error  $(tail -n1 "$DATA_DIR/host.log")"
  fi
  ;;

mode)
  if [[ -z ${2:-} ]]; then cfg_get mode manual; exit 0; fi
  case "$2" in
    manual | auto) cfg_set mode "$2"; echo "Mode set to $2. Reload any open tabs." ;;
    *) echo "mode must be manual or auto" >&2; exit 1 ;;
  esac
  ;;

backend)
  if [[ -z ${2:-} ]]; then cfg_get backend local; exit 0; fi
  case "$2" in
    local | anthropic) cfg_set backend "$2"; echo "Backend set to $2. Restart Chromium: omarchy-adblock restart" ;;
    *) echo "backend must be local or anthropic" >&2; exit 1 ;;
  esac
  ;;

endpoint)
  url="${2:?usage: omarchy-adblock endpoint <url>}"
  cfg_set local_endpoint "$url"
  if curl -sf --max-time 3 "$url/v1/models" >/dev/null 2>&1; then
    echo "Endpoint set to $url — a model is answering there."
  else
    echo "Endpoint set to $url — warning: nothing answering there yet."
  fi
  ;;

sites)
  shopt -s nullglob
  files=("$RULES"/*.json)
  ((${#files[@]})) || { echo "Nothing learned yet."; exit 0; }
  for f in "${files[@]}"; do
    printf '%-40s %s rules\n' "$(basename "$f" .json)" "$(rule_count "$f")"
  done
  ;;

show)
  host="${2:?usage: omarchy-adblock show <host>}"
  found=0
  for f in "$RULES/$host.json" "$USER_RULES/$host.json"; do
    [[ -f $f ]] || continue
    found=1
    [[ $f == "$USER_RULES"/* ]] && echo "# marked by hand" || echo "# learned"
    python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["block"]))' "$f"
  done
  ((found)) || { echo "Nothing known about $host."; exit 1; }
  ;;

marked)
  shopt -s nullglob
  if [[ -n ${2:-} ]]; then
    f="$USER_RULES/$2.json"
    [[ -f $f ]] || { echo "You have not marked anything on $2."; exit 1; }
    python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["block"]))' "$f"
    exit 0
  fi
  files=("$USER_RULES"/*.json)
  ((${#files[@]})) || { echo "You have not marked anything by hand yet."; exit 0; }
  for f in "${files[@]}"; do
    printf '%-40s %s marked\n' "$(basename "$f" .json)" "$(rule_count "$f")"
  done
  ;;

forget)
  host="${2:?usage: omarchy-adblock forget <host>}"
  rm -f "$RULES/$host.json"
  echo "Forgot what was learned about $host. What you marked by hand is kept."
  ;;

forget-all)
  rm -f "$RULES"/*.json 2>/dev/null || true
  echo "Forgot every learned site. What you marked by hand is kept."
  ;;

unmark)
  host="${2:?usage: omarchy-adblock unmark <host>}"
  rm -f "$USER_RULES/$host.json"
  echo "Cleared what you marked on $host."
  ;;

key)
  # The key never goes on argv or into a child process's command line: a
  # positional argument here would be readable by any local user via
  # /proc/<pid>/cmdline (and would land in shell history). Read it with no
  # echo from the controlling terminal, then hand it to the writer over
  # stdin, never as a Python argv element.
  if [[ -n ${2:-} ]]; then
    echo "the key can no longer be passed on the command line (any local user could read it); run 'omarchy-adblock key' with no argument and it will prompt" >&2
    exit 1
  fi
  k=""
  if [[ -t 0 ]]; then
    read -r -s -p "Anthropic API key: " k </dev/tty || { echo "could not read from the controlling terminal" >&2; exit 1; }
    printf '\n'
  elif exec 4<>/dev/tty 2>/dev/null; then
    exec 4<&-
    read -r -s -p "Anthropic API key: " k </dev/tty >/dev/tty
    printf '\n' >/dev/tty
  else
    echo "no controlling terminal to read the key from; run this interactively" >&2
    exit 1
  fi
  [[ -n $k ]] || { echo "no key entered" >&2; exit 1; }
  mkdir -p "$CONFIG_DIR"
  # Rewrite the line rather than append, so a second call replaces the key
  # instead of leaving a stale one above it that the host would read first.
  # The key travels to Python over fd 3 (not argv, not the heredoc's own
  # stdin, which the script itself occupies).
  python3 - "$CONFIG_DIR/env" 3<<<"$k" <<'PY'
import os, pathlib, sys
path = pathlib.Path(sys.argv[1])
key = os.fdopen(3).read().rstrip("\n")
lines = path.read_text().splitlines() if path.is_file() else []
lines = [l for l in lines if not l.startswith("ANTHROPIC_API_KEY=")]
lines.append("ANTHROPIC_API_KEY=" + key)
path.write_text("\n".join(lines) + "\n")
PY
  unset k
  chmod 600 "$CONFIG_DIR/env"
  echo "Key stored. Switch to it with: omarchy-adblock backend anthropic"
  ;;

model)
  cfg_set model "${2:?usage: omarchy-adblock model <model-id>}"
  echo "Model set to $2. Restart Chromium: omarchy-adblock restart"
  ;;

log)
  if [[ -s "$DATA_DIR/host.log" ]]; then
    tail -n "${2:-20}" "$DATA_DIR/host.log"
  else
    echo "No errors logged."
  fi
  ;;

update-check)   exec bash "$UPDATE_SH" check "${@:2}" ;;
update-dismiss) exec bash "$UPDATE_SH" dismiss "${@:2}" ;;
update-run)     exec bash "$UPDATE_SH" run "${@:2}" ;;
restart)
  # The host manifest and the extension are both read at browser startup, so a
  # new window is not enough — every Chromium process has to go.
  pkill -x chromium 2>/dev/null || true
  sleep 1
  setsid -f chromium >/dev/null 2>&1 || true
  echo "Chromium restarted."
  ;;

stats)
  f="$DATA_DIR/stats.json"
  [[ -f $f ]] || { echo "Nothing removed yet."; exit 0; }
  python3 - "$f" "${2:-}" <<'PY2'
import json, sys
d = json.load(open(sys.argv[1])); host = sys.argv[2]
kinds = [("ads", "Ads removed"), ("trackers", "Trackers blocked"),
         ("consent", "Consent dialogs declined"), ("legal", "Legal notices removed")]
row = d["sites"].get(host) if host else d["totals"]
if host and not row:
    print(f"Nothing removed on {host} yet."); sys.exit(0)
print(host or "All sites")
for k, label in kinds:
    print(f"  {label:26} {row.get(k, 0):>8,}")
if not host:
    top = sorted(d["sites"].items(), key=lambda kv: -sum(kv[1].get(k, 0) for k, _ in kinds))[:10]
    if top:
        print("\nBusiest sites")
        for h, r in top:
            print(f"  {h:34} {r.get('ads',0):>5} ads {r.get('trackers',0):>5} trackers "
                  f"{r.get('consent',0):>3} consent {r.get('legal',0):>3} legal")
PY2
  ;;

private)
  flags="$HOME/.config/chromium-flags.conf"
  case "${2:-}" in
    "")
      if grep -qx -- "--incognito" "$flags" 2>/dev/null; then echo on; else echo off; fi
      ;;
    on)
      grep -qx -- "--incognito" "$flags" 2>/dev/null || echo "--incognito" >>"$flags"
      cfg_set history true bool
      # Without this every window is incognito and the blocker runs in none of
      # them: no blocking, no toolbar button, and no local history either.
      set_incognito on
      cat <<MSG

Private mode on. Chromium opens in incognito from its next start, the blocker
runs there, and your history is kept locally in $DATA_DIR/history.jsonl.
Undo at any time with: omarchy-adblock private off

Incognito keeps no logins between sessions. That is the point, and it is why
this is off unless you turn it on.
MSG
      ;;
    off)
      if [[ -f $flags ]]; then
        grep -vx -- "--incognito" "$flags" >"$flags.tmp" && mv "$flags.tmp" "$flags"
      fi
      cfg_set history false bool
      echo "Private mode off. Local history is no longer recorded; what was kept stays until you delete it."
      ;;
    *) echo "usage: omarchy-adblock private [on|off]" >&2; exit 1 ;;
  esac
  ;;

dashboard)
  self="${BASH_SOURCE[0]}"
  /usr/bin/bash "$self" status || true
  echo
  /usr/bin/bash "$self" stats || true
  echo
  /usr/bin/bash "$self" incognito || true
  echo
  read -r -p "Press Enter to close. " _ || true
  ;;

incognito)
  case "${2:-}" in
    "") echo "Allow in Incognito:"; incognito_prefs status ;;
    on | off) set_incognito "$2" ;;
    *) echo "usage: omarchy-adblock incognito [on|off]" >&2; exit 1 ;;
  esac
  ;;

history)
  f="$DATA_DIR/history.jsonl"
  [[ -s $f ]] || { echo "No local history. It is recorded only in private mode."; exit 0; }
  python3 - "$f" "${2:-}" <<'PY2'
import json, sys, time
q = sys.argv[2].lower()
rows = []
for line in open(sys.argv[1]):
    try:
        r = json.loads(line)
    except ValueError:
        continue
    if q and q not in r["url"].lower() and q not in r.get("title", "").lower():
        continue
    rows.append(r)
for r in rows[-50:]:
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(r["ts"]))
    print(f"{when}  {r.get('title','')[:50]:50}  {r['url'][:80]}")
print(f"\n{len(rows)} entries" + (f" matching '{sys.argv[2]}'" if q else ""))
PY2
  ;;

-h | --help | help) usage ;;
*) usage; exit 1 ;;
esac
